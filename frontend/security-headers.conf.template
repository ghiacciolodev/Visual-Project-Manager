# Response headers for everything this server sends.
#
# Included rather than written once at server level, and that is not tidiness:
# `add_header` in a location block *replaces* every add_header inherited from
# its parent rather than adding to it. A single `add_header Cache-Control` in
# the assets location would therefore silently drop all of these from exactly
# the files that most need `nosniff`. Included in both places, they cannot
# drift apart the way two copies would.
#
# `always` so they are sent on error responses too. A 404 from the SPA fallback
# is still a document the browser will render.

# The one that matters, and the one that took work to make possible.
#
# SECURITY.md names "any successful XSS reads both tokens" as this project's
# first weakness, because the access and refresh tokens live in sessionStorage.
# This is the defence in depth for exactly that: with `script-src 'self'` an
# injected <script>, an inline handler and an eval'd string are all refused,
# so an injection has to find a same-origin file to abuse rather than simply
# writing its own.
#
# Making that strict directive possible is why `optimization.styles.
# inlineCritical` is false in angular.json. With it on, Angular ships the
# stylesheet as `<link media="print" onload="this.media='all'">` with the plain
# link only inside <noscript> — an inline event handler that is the *only* path
# by which a scripted browser gets any CSS at all. `script-src 'self'` blocks
# it, and the application renders completely unstyled. Turning the inliner off
# emits an ordinary <link>, which needs no exception.
#
# style-src keeps 'unsafe-inline', and that is a real weakening stated rather
# than hidden. Angular injects component styles as <style> elements at runtime;
# without a nonce they are inline styles. A nonce would have to be minted per
# response and substituted into both this header and an ngCspNonce attribute,
# which a server handing out static files is the wrong shape for, and it would
# mean index.html could never be cached. The trade is deliberate: CSS injection
# can leak some information through selectors, and script injection can do
# anything at all, so the strictness is spent where it buys the most. Note that
# the chart's `[style.background]` bindings need no exception either way —
# Angular writes those through the CSSOM, which style-src does not govern.
#
# connect-src is substituted at container start from the same two environment
# variables that produce config.json, so the policy and the application cannot
# disagree about where the API is. They used to be written here by hand, next
# to a bundle with the same addresses compiled into it, which meant three
# copies of one fact and an image that only worked on the machine that built
# it. See docker-entrypoint.d/40-vpm-runtime-config.sh.
#
# A mismatch here is the least helpful failure available: every request
# blocked, nothing in the server log, and the reason only in the browser
# console. Deriving both from one value is what removes the possibility.
# style-src and font-src used to name two Google domains, because the typeface
# was fetched from fonts.googleapis.com. It is served from here now, so both
# say 'self' and mean it: apart from the API, which connect-src names, there is
# no host in this policy but this one.
add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ${CSP_CONNECT_SRC}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;

# Stops a browser second-guessing a Content-Type. Without it a file served as
# text/plain that happens to contain markup can be sniffed into HTML.
add_header X-Content-Type-Options "nosniff" always;

# Superseded by frame-ancestors above for anything current, and still worth
# sending: it is what an older browser understands.
add_header X-Frame-Options "DENY" always;

# The default sends the full URL to same-origin destinations and the origin
# elsewhere; this application's URLs carry project ids, so cross-origin
# requests get the origin alone.
add_header Referrer-Policy "strict-origin-when-cross-origin" always;

# Nothing here uses any of them, so nothing here should be able to ask.
add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
