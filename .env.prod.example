# Copy to .env on the server:  cp .env.prod.example .env
#
# Unlike .env.example, none of these is a development value with a working
# default. The production overlay refuses to start when one is missing, which
# is the point: a password that works out of the box is a password nobody
# changes, and this stack is about to be reachable from the internet.
#
# Generate each one and do not reuse them:
#
#   openssl rand -base64 32

# The domain pointing at this machine. Caddy asks Let's Encrypt for a
# certificate for exactly this name, and every address the browser is told
# about is built from it: the API, the token issuer, the redirect URIs and the
# content security policy.
PUBLIC_HOST=vpm.example.com

# Where Let's Encrypt sends expiry warnings if renewal ever stops working.
ACME_EMAIL=you@example.com

# The application database.
POSTGRES_DB=vpm
POSTGRES_USER=vpm
POSTGRES_PASSWORD=

# Keycloak's own database, which is a separate one on purpose.
KEYCLOAK_DB_PASSWORD=

# The Keycloak administrator. The console is not published, so this is
# reachable only over an SSH tunnel, and it is still the single credential
# that owns every account on the instance.
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=

# The shared password for the four demo accounts. This one is meant to be
# guessable and is printed in the README: the whole point is that anybody can
# sign in and look around. It is safe only because the nightly seed puts the
# plan back and because those accounts can reach nothing else.
DEMO_PASSWORD=demo
