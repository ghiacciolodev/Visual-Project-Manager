# Copy this file to .env  ->  copy .env.example .env
#
# NOTE: these passwords protect containers listening on localhost only. They
# are development values, not secrets. Real secrets live in the deployment
# platform's environment variables and in GitHub Secrets, never in a file
# inside the repository.

POSTGRES_DB=vpm
POSTGRES_USER=vpm
POSTGRES_PASSWORD=vpm_local_dev
POSTGRES_PORT=5432

KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_PASSWORD=keycloak_local_dev

BACKEND_PORT=8080
FRONTEND_PORT=4200
