# Copy this file to .env  ->  copy .env.example .env
#
# NOTE: this password protects a Postgres container listening on localhost
# only. It is not a real secret, it is a development value. Actual secrets
# live in the deployment platform's environment variables and in GitHub
# Secrets, never in a file inside the repository.

POSTGRES_DB=vpm
POSTGRES_USER=vpm
POSTGRES_PASSWORD=vpm_local_dev
POSTGRES_PORT=5432