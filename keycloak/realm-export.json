{
  "realm": "vpm",
  "enabled": true,
  "displayName": "Visual Project Manager",
  "sslRequired": "none",
  "loginTheme": "vpm",
  "registrationAllowed": true,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "failureFactor": 5,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@vpm.local",
    "fromDisplayName": "Visual Project Manager",
    "ssl": "false",
    "starttls": "false",
    "auth": "false"
  },
  "roles": {
    "realm": [
      {
        "name": "vpm-user",
        "description": "May sign in to Visual Project Manager"
      }
    ]
  },
  "defaultRoles": [
    "vpm-user"
  ],
  "clients": [
    {
      "clientId": "vpm-frontend",
      "name": "VPM Angular client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:4200/*"
      ],
      "webOrigins": [
        "http://localhost:4200"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*"
      }
    }
  ]
}
